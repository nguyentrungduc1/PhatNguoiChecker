<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Biển số xe"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/et_license_plate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="VD: 73A05550"
        android:inputType="textCapCharacters"
        android:textAllCaps="true"
        android:textSize="18sp"
        android:maxLength="12" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loại phương tiện"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rg_vehicle_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_car"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🚗  Xe ô tô"
            android:textSize="15sp"
            android:checked="true"
            android:paddingStart="8dp" />

        <RadioButton
            android:id="@+id/rb_moto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🛵  Xe máy"
            android:textSize="15sp"
            android:paddingStart="8dp" />

        <RadioButton
            android:id="@+id/rb_ebike"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚡  Xe máy điện"
            android:textSize="15sp"
            android:paddingStart="8dp" />

    </RadioGroup>

</LinearLayout>
